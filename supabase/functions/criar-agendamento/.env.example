# ===========================================================================
# Variáveis de ambiente da Edge Function "criar-agendamento"
# Copie para .env (na pasta supabase/functions/criar-agendamento) OU defina
# como Secrets no painel Supabase (Settings > Edge Functions > Secrets).
#
# NUNCA coloque estes valores no .env do frontend (Vite) nem em src/.
# ===========================================================================

# Connection string / banco usado pela Edge Function (server-side, segredo).
# O Supabase injeta SUPABASE_DB_URL automaticamente nas Edge Functions.
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Origens permitidas no CORS (separadas por vírgula). Sem isso a chamada é
# recusada (403). Ex.: https://agenda.suaempresa.com.br,http://localhost:5173
PUBLIC_ORIGINS="http://localhost:5173"

# Fuso horário LOCAL da barbearia (para validar horário de funcionamento).
PUBLIC_TIMEZONE="America/Sao_Paulo"
